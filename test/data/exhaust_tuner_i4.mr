// ExhaustTuner Inline-4 - exported for Engine Simulator as a ROUGH LISTENING PREVIEW.
// Engine Simulator is a reference/example model, not an accurate acoustic simulation:
// each exhaust system is one lumped volume, pipe length is a pure audio delay, and the
// final sound is shaped by a recorded impulse response. Do not use it to judge a design.
//
// Generated by export_es.js for target: Engine Simulator Community Edition v0.1.14a (load with "Load Script")
// Value tags: [spec] calculator input, [derived] formula on calculator inputs,
// [donor] copied from the MIT-licensed engine-sim example assets/engines/atg-video-1/06_subaru_ej25.mr (Subaru EJ25 2.5 L four (forward rotation, standard valvetrain)),
//         Copyright 2022 AngeTheGreat (Ange Yaghi), MIT License, github.com/ange-yaghi/engine-sim
// [default] engine-sim default from es/objects/objects.mr (parameter left out).
// Cam timing convention: IVO deg BTDC, IVC deg ABDC, EVO deg BBDC, EVC deg ATDC at
// 1.27 mm valve lift. Cycle angle 0 = cylinder 1 TDC (compression).
// NOTE: flow coefficients: the runner, primary and outlet orifices use the donor engine's ratings, not the spec diameters (ideal orifices of the spec diameters over-read badly on the dyno)
// Not representable in engine-sim (ignored): collector merge geometry/taper; X/H-pipe crossovers; mufflers/resonators/chambers (only the impulse response file); pipe diameter changes after the collector; tip/outlet length; idle speed target (idle_rpm only sets the dyno minimum).

import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
}

private node exhausttuner_inline_4_head {
    input intake_camshaft;
    input exhaust_camshaft;
    input chamber_volume;
    input intake_runner_cross_section_area;
    input exhaust_runner_cross_section_area;
    input intake_runner_volume: 149.6 * units.cc; // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:19 (port volume)
    input exhaust_runner_volume: 50.0 * units.cc; // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:21 (port volume)
    input flip_display: false;
    alias output __out: head;

    // port flow (cfm @ 28 inH2O vs valve lift in thou): [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:29-40
    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0, 0)
        .add_flow_sample(50, 58)
        .add_flow_sample(100, 103)
        .add_flow_sample(150, 156)
        .add_flow_sample(200, 214)
        .add_flow_sample(250, 249)
        .add_flow_sample(300, 268)
        .add_flow_sample(350, 280)
        .add_flow_sample(400, 280)
        .add_flow_sample(450, 281)

    // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:42-53
    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0, 0)
        .add_flow_sample(50, 37)
        .add_flow_sample(100, 72)
        .add_flow_sample(150, 113)
        .add_flow_sample(200, 160)
        .add_flow_sample(250, 196)
        .add_flow_sample(300, 222)
        .add_flow_sample(350, 235)
        .add_flow_sample(400, 245)
        .add_flow_sample(450, 246)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,
        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

private node exhausttuner_inline_4_camshaft {
    input intake_lobe_profile;
    input exhaust_lobe_profile;
    input intake_lobe_center;
    input exhaust_lobe_center;
    input advance: 0 * units.deg;  // timing is carried entirely by the lobe centerlines
    input base_radius;

    output intake_cam_0: _intake_cam_0;
    output exhaust_cam_0: _exhaust_cam_0;

    camshaft_parameters params(advance: advance, base_radius: base_radius)
    camshaft _intake_cam_0(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_0(params, lobe_profile: exhaust_lobe_profile)

    label rot360(360 * units.deg)
    // lobe peak at cycle angle = centerline + advance (camshaft.cpp:41-59, camshaft.h:39);
    // offsets = [derived] each cylinder's TDC-compression cycle angle from spec.firingOrder
    _exhaust_cam_0
        .add_lobe(rot360 - exhaust_lobe_center + 0.0 * units.deg) // cyl 1
        .add_lobe(rot360 - exhaust_lobe_center + 540.0 * units.deg) // cyl 2
        .add_lobe(rot360 - exhaust_lobe_center + 180.0 * units.deg) // cyl 3
        .add_lobe(rot360 - exhaust_lobe_center + 360.0 * units.deg) // cyl 4
    _intake_cam_0
        .add_lobe(rot360 + intake_lobe_center + 0.0 * units.deg) // cyl 1
        .add_lobe(rot360 + intake_lobe_center + 540.0 * units.deg) // cyl 2
        .add_lobe(rot360 + intake_lobe_center + 180.0 * units.deg) // cyl 3
        .add_lobe(rot360 + intake_lobe_center + 360.0 * units.deg) // cyl 4
}

public node exhausttuner_inline_4 {
    alias output __out: engine;

    engine engine(
        name: "ExhaustTuner Inline-4",  // [spec] name
        starter_torque: 70 * units.lb_ft,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:121
        starter_speed: 500 * units.rpm,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:122
        redline: 7500.0 * units.rpm,  // [spec] redline_rpm
        dyno_min_speed: 800.0 * units.rpm,  // [spec] idle_rpm (engine-sim has no idle target; this is the dyno sweep start)
        throttle_gamma: 2.0,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:128
        fuel: fuel(max_turbulence_effect: 2.5, max_burning_efficiency: 0.75),  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:124-127
        hf_gain: 0.01,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:129
        noise: 1.0,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:130
        jitter: 0.5,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:131
        simulation_frequency: 20000  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:132
    )

    wires wires()

    label bore(91.385 * units.mm)  // [spec] bore_mm
    label stroke(76.154 * units.mm)  // [spec] stroke_mm
    label rod_length(129.462 * units.mm)  // [spec] rod_mm
    label compression_ratio(11.0)  // [spec] cr
    label compression_height(1.0 * units.inch)  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:141
    // [derived] total clearance volume for spec.cr: swept / (cr - 1). With deck_height =
    // stroke/2 + rod + compression_height the TDC volume is exactly chamber_volume
    // (combustion_chamber.cpp:120-132).
    label chamber_volume((constants.pi / 4.0) * bore * bore * stroke / (compression_ratio - 1.0))
    label rod_mass(535 * units.g)  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:140
    label crank_mass(9.39 * units.kg)  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:142
    label flywheel_mass(6.8 * units.kg)  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:143
    label flywheel_radius(6 * units.inch)  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:144
    label crank_moment(disk_moment_of_inertia(mass: crank_mass, radius: stroke / 2))  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:146-148
    label flywheel_moment(disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius))  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:149-151
    label other_moment(disk_moment_of_inertia(mass: 10 * units.kg, radius: 6.0 * units.cm))  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:152-154

    crankshaft c0(
        throw: stroke / 2,  // [derived] stroke / 2
        flywheel_mass: flywheel_mass,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:158
        mass: crank_mass,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:159
        friction_torque: 1.0 * units.lb_ft,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:160
        moment_of_inertia: crank_moment + flywheel_moment + other_moment,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:161-162
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90.0 * units.deg  // [derived] 90 deg + bank A angle (cylinder 1 at TDC at cycle angle 0)
    )

    // [derived] journal angle = TDC cycle angle + (bank angle - bank A angle), mod 360
    rod_journal rj0(angle: 0.0 * units.deg)  // cyl 1
    rod_journal rj1(angle: 180.0 * units.deg)  // cyl 2
    rod_journal rj2(angle: 180.0 * units.deg)  // cyl 3
    rod_journal rj3(angle: 0.0 * units.deg)  // cyl 4
    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)

    piston_parameters piston_params(
        mass: (414 + 152) * units.g,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:179
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(mass: rod_mass, length: rod_length),  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:187-190
        center_of_mass: 0.0,
        length: rod_length
    )

    intake intake(
        plenum_volume: 0.999 * units.L,  // [spec] intake.plenumL
        plenum_cross_section_area: 20.0 * units.cm2,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:197
        intake_flow_rate: k_carb(800.0),  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:198 (throttle/carb rating)
        runner_flow_rate: k_carb(250.0),  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:199
        runner_length: 300.0 * units.mm,  // [spec] intake.runnerL_mm
        idle_flow_rate: k_carb(0.0),  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:201
        idle_throttle_plate_position: 0.9985,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:202
        velocity_decay: 0.5  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:203
    )

    exhaust_system_parameters es_params(
        collector_cross_section_area: circle_area(39.7575 * units.mm),  // [spec] exhaust.collectorD_mm / 2 (circle_area takes a radius)
        outlet_flow_rate: k_carb(1000.0),  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:207
        primary_tube_length: 720.969 * units.mm,  // [spec] exhaust.primaryL_mm
        primary_flow_rate: k_carb(200.0),  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:209
        velocity_decay: 1.0  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:210
    )

    exhaust_system exhaust0(  // cylinders 1, 2, 3, 4
        es_params,
        length: 487.946 * units.mm,  // [spec] exhaust.systemL_mm (collector to tip)
        audio_volume: 0.5 * 8,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:216
        impulse_response: ir_lib.mild_exhaust_0,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:217
        // 1-D exhaust geometry (docs/exhaust-1d.md); giving any of these selects the 1-D model
        primary_diameter: 44.45 * units.mm,  // [spec] exhaust.primaryD_mm
        collector_diameter: 79.515 * units.mm,  // [spec] exhaust.collectorD_mm
        collector_length: 487.946 * units.mm  // [spec] exhaust.systemL_mm
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height  // [derived] same formula as all shipped engines
    )

    cylinder_bank b0(bank_params, angle: 0.0 * units.deg)  // [derived] inline
    b0
        .add_cylinder(  // cylinder 1
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),  // blowby [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:234
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1
        )
        .add_cylinder(  // cylinder 2
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),  // blowby [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:234
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2
        )
        .add_cylinder(  // cylinder 3
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),  // blowby [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:234
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3
        )
        .add_cylinder(  // cylinder 4
            piston: piston(piston_params, blowby: k_28inH2O(0.001)),  // blowby [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:234
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire4
        )
        .set_cylinder_head(
            exhausttuner_inline_4_head(
                chamber_volume: chamber_volume,
                intake_runner_cross_section_area: circle_area(17.3425 * units.mm),  // [spec] intake.runnerD_mm / 2
                exhaust_runner_cross_section_area: circle_area(22.225 * units.mm),  // [spec] exhaust.primaryD_mm / 2 (port + primary share this area, combustion_chamber.cpp:94-109)
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0,
                flip_display: false)
        )

    engine
        .add_cylinder_bank(b0)

    engine.add_crankshaft(c0)

    // [derived] spec.cam: intake 260.0 deg / exhaust 260.0 deg at 1.27 mm,
    // ICL 110.0 ATDC, ECL 110.0 BTDC, LSA 110.0. duration_at_50_thou is solved from
    // harmonic_cam_lobe's own formula (actions.h:437-463) so the generated lobe crosses the
    // check lift exactly at the spec events.
    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 289.256 * units.deg,  // [derived] from spec.cam.ivo/ivc
        gamma: 2.0,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:286
        lift: 11.642 * units.mm,  // [spec] cam.liftIn_mm
        steps: 100  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:288
    )
    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 291.375 * units.deg,  // [derived] from spec.cam.evo/evc
        gamma: 2.0,  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:286
        lift: 10.235 * units.mm,  // [spec] cam.liftEx_mm
        steps: 100  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:288
    )

    exhausttuner_inline_4_camshaft camshaft(
        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 110.0 * units.deg,  // [derived] (IVC - IVO + 180) / 2
        exhaust_lobe_center: 110.0 * units.deg,  // [derived] (EVO - EVC + 180) / 2
        advance: 0 * units.deg,
        base_radius: (34.0 / 2) * units.mm  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:305 (display only)
    )

    function timing_curve(1000 * units.rpm)  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:308-314
    timing_curve
        .add_sample(0 * units.rpm, 25 * units.deg)
        .add_sample(1000 * units.rpm, 25 * units.deg)
        .add_sample(2000 * units.rpm, 30 * units.deg)
        .add_sample(3000 * units.rpm, 40 * units.deg)
        .add_sample(4000 * units.rpm, 40 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 7500.0 * units.rpm,  // [spec] redline_rpm
        limiter_duration: 0.08)  // [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:319
    // [derived] spark at each cylinder's TDC-compression cycle angle (ignition_module.cpp:53-98)
    ignition_module
        .connect_wire(wires.wire1, 0.0 * units.deg)
        .connect_wire(wires.wire3, 180.0 * units.deg)
        .connect_wire(wires.wire4, 360.0 * units.deg)
        .connect_wire(wires.wire2, 540.0 * units.deg)

    engine.add_ignition_module(ignition_module)
}

// [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:329-339
private node exhausttuner_inline_4_vehicle {
    alias output __out:
        vehicle(
            mass: 2700 * units.lb,
            drag_coefficient: 0.2,
            cross_sectional_area: (66 * units.inch) * (56 * units.inch),
            diff_ratio: 3.9,
            tire_radius: 10 * units.inch,
            rolling_resistance: 300 * units.N
        );
}

// [donor] assets/engines/atg-video-1/06_subaru_ej25.mr:341-352
private node exhausttuner_inline_4_transmission {
    alias output __out:
        transmission(max_clutch_torque: 300 * units.lb_ft)
        .add_gear(3.636)
        .add_gear(2.375)
        .add_gear(1.761)
        .add_gear(1.346)
        .add_gear(0.971)
        .add_gear(0.756);
}

// set_engine/set_transmission/set_vehicle exist in both CE and upstream; CE's run()
// (es/actions/actions.mr) is defined as exactly these three calls.
public node main {
    set_engine(exhausttuner_inline_4())
    set_transmission(exhausttuner_inline_4_transmission())
    set_vehicle(exhausttuner_inline_4_vehicle())
}

main()
